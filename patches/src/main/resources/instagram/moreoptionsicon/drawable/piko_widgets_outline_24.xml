<?xml version="1.0" encoding="utf-8"?>
<!--
  Piko custom icon for the "more options" overflow button (posts + reels).
  A 2x2 grid where the bottom-right cell is replaced with a plus sign.
  Drawn stroke-only (no fill) to match Instagram's outline icon style;
  colour is applied at runtime via the host ImageView's colour filter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top-left square -->
    <path
        android:pathData="M4.8,3 L8.2,3 A1.8,1.8 0 0 1 10,4.8 L10,8.2 A1.8,1.8 0 0 1 8.2,10 L4.8,10 A1.8,1.8 0 0 1 3,8.2 L3,4.8 A1.8,1.8 0 0 1 4.8,3 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Top-right square -->
    <path
        android:pathData="M15.8,3 L19.2,3 A1.8,1.8 0 0 1 21,4.8 L21,8.2 A1.8,1.8 0 0 1 19.2,10 L15.8,10 A1.8,1.8 0 0 1 14,8.2 L14,4.8 A1.8,1.8 0 0 1 15.8,3 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-left square -->
    <path
        android:pathData="M4.8,14 L8.2,14 A1.8,1.8 0 0 1 10,15.8 L10,19.2 A1.8,1.8 0 0 1 8.2,21 L4.8,21 A1.8,1.8 0 0 1 3,19.2 L3,15.8 A1.8,1.8 0 0 1 4.8,14 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bottom-right plus -->
    <path
        android:pathData="M17.5,14 L17.5,21 M14,17.5 L21,17.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>

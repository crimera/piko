<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Switch
        android:id="@+id/post_filter_enabled"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/piko_post_filter_enabled"
        android:textColor="?attr/coreColorPrimaryText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/post_filter_explanation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/piko_post_filter_explanation"
        android:textColor="?attr/coreColorSecondaryText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_filter_enabled" />

    <ListView
        android:id="@+id/post_filter_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:dividerHeight="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/post_filter_explanation" />

    <TextView
        android:id="@+id/post_filter_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/piko_post_filter_empty"
        android:textColor="?attr/coreColorSecondaryText"
        app:layout_constraintBottom_toBottomOf="@id/post_filter_list"
        app:layout_constraintEnd_toEndOf="@id/post_filter_list"
        app:layout_constraintStart_toStartOf="@id/post_filter_list"
        app:layout_constraintTop_toTopOf="@id/post_filter_list" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/post_filter_add"
        style="@style/FabStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:contentDescription="@string/piko_post_filter_add"
        android:src="@drawable/ic_plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
